{
  "$schema": "https://turborepo.org/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "build/**"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "dev": {
      "cache": false
    },
    "resume-parser-build": {
      "dependsOn": ["^build"],
      "outputs": ["services/resume-parser/dist/**"]
    },
    "resume-parser-lint": {
      "outputs": []
    },
    "resume-parser-test": {
      "outputs": []
    },
    "matching-engine-build": {
      "dependsOn": ["^build"],
      "outputs": ["services/matching-engine/dist/**"]
    },
    "matching-engine-lint": {
      "outputs": []
    },
    "matching-engine-test": {
      "outputs": []
    }
  }
}
